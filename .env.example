APP_NAME=CTCC V2
APP_VERSION=1.6.8
ENVIRONMENT=development
LOG_LEVEL=INFO

HOST=0.0.0.0
PORT=8000
WEB_CONCURRENCY=1

POSTGRES_USER=ctcc
POSTGRES_PASSWORD=replace_with_a_long_local_password
POSTGRES_DB=ctcc
DATABASE_URL=postgresql+asyncpg://ctcc:replace_with_a_long_local_password@postgres:5432/ctcc
REDIS_URL=redis://redis:6379/0

# Protects private CTCC endpoints. Replace this public placeholder with at
# least 32 cryptographically random characters before any Live activation.
API_TOKEN=replace_with_at_least_32_random_characters
READINESS_REQUIRE_REDIS=true
READINESS_REQUIRE_DATABASE=true

# Fail-safe default. Live mode still has independent read, write, and runtime arm gates.
TRADING_MODE=analysis_only
AUTO_TRADE=false
LIVE_TRADING=false

OKX_REST_BASE_URL=https://openapi.okx.com
OKX_PUBLIC_TIMEOUT_SECONDS=10
OKX_PUBLIC_MAX_RETRIES=2

STRATEGY_MIN_SCORE=72
STRATEGY_MIN_RISK_REWARD=1.8

# Risk engine (0.005 = 0.5% account risk)
RISK_PER_TRADE_PCT=0.005
MAX_DAILY_LOSS_PCT=0.02
MAX_WEEKLY_LOSS_PCT=0.05
MAX_DRAWDOWN_PCT=0.10
MAX_CONSECUTIVE_LOSSES=3
MAX_OPEN_POSITIONS=2
MAX_SAME_DIRECTION_POSITIONS=1
MAX_CORRELATED_POSITIONS=1
ORDER_SIZE_CAP_USDT=5000

# Paper broker
PAPER_STARTING_BALANCE=10000
PAPER_TAKER_FEE_RATE=0.0005
PAPER_MAKER_FEE_RATE=0.0002
PAPER_SLIPPAGE_BPS=2

# OKX public WebSocket. No API key is required.
OKX_WS_ENABLED=true
OKX_WS_PUBLIC_URL=wss://ws.okx.com:8443/ws/v5/public
OKX_WS_SYMBOLS=BTC-USDT-SWAP,ETH-USDT-SWAP
OKX_WS_CONNECT_TIMEOUT_SECONDS=15
OKX_WS_RECEIVE_TIMEOUT_SECONDS=25
OKX_WS_PING_TIMEOUT_SECONDS=10
OKX_WS_RECONNECT_INITIAL_SECONDS=1
OKX_WS_RECONNECT_MAX_SECONDS=30
OKX_WS_MAX_MESSAGE_SIZE=2000000
PAPER_AUTO_TICKS=true

# Auto Paper Orchestrator. It must stay false while using OKX Demo mode.
PAPER_AUTO_EXECUTION=false
PAPER_SCAN_SYMBOLS=BTC-USDT-SWAP,ETH-USDT-SWAP
PAPER_SCAN_INTERVAL_SECONDS=300
PAPER_SCAN_INITIAL_DELAY_SECONDS=10
PAPER_SCAN_CANDLE_LIMIT=250
PAPER_SCAN_MAX_SNAPSHOT_AGE_SECONDS=30
PAPER_SCAN_MAX_ENTRY_DRIFT_BPS=50
PAPER_SCAN_COOLDOWN_SECONDS=900
PAPER_SCAN_HISTORY_LIMIT=100

# Persistence and restart recovery.
PAPER_PERSISTENCE_ENABLED=true
PAPER_PERSIST_MARK_INTERVAL_SECONDS=30
PAPER_RECOVERY_HISTORY_LIMIT=100

# OKX Live production boundary. All switches are fail-safe by default.
# Use a dedicated IP-bound key with Read + Trade only; Withdraw is forbidden.
# Never paste credentials into chat, screenshots, logs, or source control.
OKX_LIVE_ENABLED=false
OKX_LIVE_ALLOW_ORDER_WRITES=false
OKX_LIVE_REST_BASE_URL=https://openapi.okx.com
OKX_LIVE_API_KEY=
OKX_LIVE_API_SECRET=
OKX_LIVE_API_PASSPHRASE=
OKX_LIVE_TIMEOUT_SECONDS=10
OKX_LIVE_READ_MAX_RETRIES=2
OKX_LIVE_ALLOWED_SYMBOLS=BTC-USDT-SWAP,ETH-USDT-SWAP
OKX_LIVE_MAX_ORDER_SIZE_CONTRACTS=1
OKX_LIVE_MAX_NOTIONAL_USDT=1000
OKX_LIVE_MAX_OPEN_POSITIONS=1
OKX_LIVE_MAX_LEVERAGE=1
OKX_LIVE_REQUIRE_PROTECTION=true
OKX_LIVE_REQUIRE_IP_BOUND_KEY=true
OKX_LIVE_FORBID_WITHDRAW_PERMISSION=true
OKX_LIVE_AUTO_RECONCILE_ON_START=false
OKX_LIVE_ORDER_DETAIL_POLL_ATTEMPTS=5
OKX_LIVE_ORDER_DETAIL_POLL_DELAY_SECONDS=0.5
OKX_LIVE_ORDER_EXPIRY_MILLISECONDS=5000
OKX_LIVE_ARM_TTL_SECONDS=300
OKX_LIVE_MAX_SUBMISSIONS_PER_ARM=1
OKX_LIVE_SESSION_LOSS_LIMIT_PCT=0.0025
OKX_LIVE_CANCEL_ALL_AFTER_SECONDS=30
OKX_LIVE_ORDER_TAG=CTCCV168
OKX_LIVE_REQUIRE_FLAT_START=true
OKX_LIVE_AUTO_DISARM=true

# Live automation never auto-arms or resumes after restart. Keep false until
# read-only verification and one manually controlled micro-order both pass.
OKX_LIVE_AUTO_EXECUTION=false
OKX_LIVE_SCAN_SYMBOLS=BTC-USDT-SWAP,ETH-USDT-SWAP
OKX_LIVE_SCAN_INTERVAL_SECONDS=300
OKX_LIVE_SCAN_INITIAL_DELAY_SECONDS=10
OKX_LIVE_SCAN_CANDLE_LIMIT=250
OKX_LIVE_SCAN_MAX_SNAPSHOT_AGE_SECONDS=30
OKX_LIVE_SCAN_MAX_ENTRY_DRIFT_BPS=20
OKX_LIVE_AUTOMATION_LEVERAGE=1

# OKX Demo Broker and explicitly armed automation. Use Demo credentials only.
# Never paste credentials into chat, screenshots, logs, or source control.
OKX_DEMO_ENABLED=false
OKX_DEMO_ALLOW_ORDER_WRITES=false
OKX_DEMO_REST_BASE_URL=https://openapi.okx.com
OKX_DEMO_API_KEY=
OKX_DEMO_API_SECRET=
OKX_DEMO_API_PASSPHRASE=
OKX_DEMO_TIMEOUT_SECONDS=10
OKX_DEMO_READ_MAX_RETRIES=2
OKX_DEMO_ALLOWED_SYMBOLS=BTC-USDT-SWAP,ETH-USDT-SWAP
OKX_DEMO_MAX_ORDER_SIZE_CONTRACTS=1
OKX_DEMO_MAX_OPEN_POSITIONS=1
OKX_DEMO_MAX_LEVERAGE=3
OKX_DEMO_REQUIRE_PROTECTION=true
OKX_DEMO_AUTO_RECONCILE_ON_START=false
OKX_DEMO_ORDER_DETAIL_POLL_ATTEMPTS=3
OKX_DEMO_ORDER_DETAIL_POLL_DELAY_SECONDS=0.4


# Safe Demo Automation. Capability is disabled by default.
# Enabling this does NOT arm or start the scheduler; arming is an authenticated runtime action.
OKX_DEMO_AUTO_EXECUTION=false
OKX_DEMO_SCAN_SYMBOLS=BTC-USDT-SWAP,ETH-USDT-SWAP
OKX_DEMO_SCAN_INTERVAL_SECONDS=300
OKX_DEMO_SCAN_INITIAL_DELAY_SECONDS=10
OKX_DEMO_SCAN_CANDLE_LIMIT=250
OKX_DEMO_SCAN_MAX_SNAPSHOT_AGE_SECONDS=30
OKX_DEMO_SCAN_MAX_ENTRY_DRIFT_BPS=30
OKX_DEMO_TRADE_COOLDOWN_SECONDS=1800
OKX_DEMO_MAX_TRADES_PER_DAY=3
OKX_DEMO_DAILY_LOSS_LIMIT_PCT=0.01
OKX_DEMO_AUTOMATION_MAX_CONSECUTIVE_LOSSES=2
OKX_DEMO_AUTOMATION_LEVERAGE=1
OKX_DEMO_AUTOMATION_HISTORY_LIMIT=100

# v1.5 Demo soak testing, observability, controlled execute-soak, and performance validation.
# Observation-only soak is enabled; execute soak and order writes remain disabled.
OKX_DEMO_OBSERVABILITY_ENABLED=true
OKX_DEMO_OBSERVABILITY_HEARTBEAT_SECONDS=15
OKX_DEMO_OBSERVABILITY_STALE_AFTER_SECONDS=90
OKX_DEMO_OBSERVABILITY_ERROR_THRESHOLD=3
OKX_DEMO_OBSERVABILITY_EVENT_LIMIT=500
OKX_DEMO_OBSERVABILITY_METRICS_RUN_LIMIT=5000
OKX_DEMO_SOAK_ENABLED=true
OKX_DEMO_SOAK_ALLOW_EXECUTE=false
OKX_DEMO_SOAK_DEFAULT_DURATION_MINUTES=60
OKX_DEMO_SOAK_MAX_DURATION_MINUTES=1440
OKX_DEMO_SOAK_INTERVAL_SECONDS=300
OKX_DEMO_SOAK_MAX_RUNS=288

# Controlled execute-soak limits. These do not enable execution.
OKX_DEMO_EXECUTION_SOAK_MAX_SUBMISSIONS=1
OKX_DEMO_EXECUTION_SOAK_LOSS_LIMIT_PCT=0.0025
OKX_DEMO_EXECUTION_SOAK_REQUIRE_FLAT_START=true
OKX_DEMO_EXECUTION_SOAK_REQUIRE_PROTECTION=true
OKX_DEMO_EXECUTION_SOAK_AUTO_DISARM=true
OKX_DEMO_EXECUTION_SOAK_RECONCILE_ATTEMPTS=10
OKX_DEMO_EXECUTION_SOAK_RECONCILE_DELAY_SECONDS=1.0
# v1.5 Demo reliability and performance validation. These settings do not enable trading.
OKX_DEMO_PERFORMANCE_WINDOW_DAYS=30
OKX_DEMO_PERFORMANCE_SNAPSHOT_RETENTION_DAYS=90
OKX_DEMO_PERFORMANCE_SNAPSHOT_QUERY_LIMIT=50000
OKX_DEMO_PERFORMANCE_ORDER_QUERY_LIMIT=10000
OKX_DEMO_PERFORMANCE_MIN_ACTIVE_DAYS=7
OKX_DEMO_PERFORMANCE_MIN_REALIZED_TRADES=20
OKX_DEMO_PERFORMANCE_MAX_AVERAGE_SLIPPAGE_BPS=10
OKX_DEMO_PERFORMANCE_MIN_PROFIT_FACTOR=1.0
OKX_DEMO_PERFORMANCE_MAX_DRAWDOWN_PCT=0.02
OKX_DEMO_STRATEGY_REVIEW_MIN_TRADES=5
OKX_DEMO_STRATEGY_REVIEW_MIN_WIN_RATE=0.35
# Automatic strategy disabling is intentionally forbidden. Use authenticated operator controls.
OKX_DEMO_STRATEGY_AUTO_DISABLE=false
