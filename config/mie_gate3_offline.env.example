# Deterministic, credential-free profile for the isolated Gate 3 verifier.
# It is intentionally incapable of public-market, account, Demo, or Live I/O.
APP_NAME=CTCC V2
APP_VERSION=1.6.9
ENVIRONMENT=test
LOG_LEVEL=INFO

HOST=0.0.0.0
PORT=8000
WEB_CONCURRENCY=1

DATABASE_URL=postgresql+asyncpg://ctcc:ctcc_dev_password@postgres:5432/ctcc
REDIS_URL=redis://redis:6379/0
API_TOKEN=
READINESS_REQUIRE_REDIS=true
READINESS_REQUIRE_DATABASE=true

TRADING_MODE=analysis_only
AUTO_TRADE=false
LIVE_TRADING=false
PAPER_AUTO_TICKS=false
PAPER_AUTO_EXECUTION=false

OKX_WS_ENABLED=false

OKX_LIVE_ENABLED=false
OKX_LIVE_ALLOW_ORDER_WRITES=false
OKX_LIVE_AUTO_RECONCILE_ON_START=false
OKX_LIVE_AUTO_EXECUTION=false
OKX_LIVE_API_KEY=
OKX_LIVE_API_SECRET=
OKX_LIVE_API_PASSPHRASE=

OKX_DEMO_ENABLED=false
OKX_DEMO_ALLOW_ORDER_WRITES=false
OKX_DEMO_AUTO_RECONCILE_ON_START=false
OKX_DEMO_AUTO_EXECUTION=false
OKX_DEMO_CONTINUOUS_SESSION_ENABLED=false
OKX_DEMO_SCORE_RISK_ENABLED=false
OKX_DEMO_CAPITAL_BUCKET_ENABLED=false
OKX_DEMO_STRUCTURAL_DYNAMIC_LEVERAGE_ENABLED=false
OKX_DEMO_OBSERVABILITY_ENABLED=false
OKX_DEMO_SOAK_ENABLED=false
OKX_DEMO_SOAK_ALLOW_EXECUTE=false
OKX_DEMO_API_KEY=
OKX_DEMO_API_SECRET=
OKX_DEMO_API_PASSPHRASE=
